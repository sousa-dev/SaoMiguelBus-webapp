# --- Docker / Dokploy ---
# Host port for direct IP:port access (e.g. http://1.2.3.4:8080). Set when host
# port 80 is already taken (Traefik/Dokploy uses it).
WEBAPP_HOST_PORT=8080
# Port nginx listens on inside the container. Traefik/Dokploy domains must use
# THIS port — not WEBAPP_HOST_PORT.
WEBAPP_CONTAINER_PORT=80
#
# Dokploy domain setup (Domains tab):
#   service name: webapp
#   port:         80   (= WEBAPP_CONTAINER_PORT)
# Then redeploy after adding/changing the domain.

# --- API ---
# Base URL of the São Miguel Bus v3 API.
# Production cutover to api.saomiguelbus.com is pending; v3 currently lives on staging.
VITE_API_URL=https://staging.api.saomiguelbus.com
# Active island tenant key (sent as the X-Island header on every request).
VITE_ISLAND_KEY=sao-miguel

# --- SEO / hosting ---
# Canonical public base URL of this app (used for canonical links + sitemap).
VITE_SITE_URL=https://app.saomiguelhub.com
# Root domain used to build module subdomains (radares.<base>, meteorologia.<base>, ...).
VITE_BASE_DOMAIN=saomiguelhub.com

# --- Display ads (features/ads/providers) ---
# Ordered network waterfall tried after a first-party campaign and before the house creative.
# Ids: adsense, adsterra, mock (placeholder creative, no network), none (always unfilled).
# Leave empty to serve house creatives only. Production: "adsterra" now, "adsense,adsterra" once
# the AdSense site review passes. Scripts load only after the consent banner's "Ads" purpose is on.
VITE_WEB_AD_PROVIDERS=
# Google AdSense manual units (same publisher as the AdMob apps). Slot ids come from the
# AdSense "Ads → By ad unit" page. Non-production builds send data-adtest=on automatically;
# force with VITE_ADSENSE_TEST=on|off.
VITE_ADSENSE_CLIENT=ca-pub-8246676797736648
VITE_ADSENSE_SLOT_TOP=
VITE_ADSENSE_SLOT_INLINE=
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_FOOTER=
VITE_ADSENSE_TEST=
# Adsterra Native Banner tags: the full invoke.js URL shown in the Adsterra dashboard for each
# placement (…/<32-hex-key>/invoke.js). Sidebar/footer fall back to the inline tag.
VITE_ADSTERRA_NATIVE_TOP=
VITE_ADSTERRA_NATIVE_INLINE=
VITE_ADSTERRA_NATIVE_SIDEBAR=
VITE_ADSTERRA_NATIVE_FOOTER=
# Height (px) reserved for an Adsterra native unit (default 120; match the layout chosen in the dashboard).
VITE_ADSTERRA_FRAME_HEIGHT=
# Dev only: make the mock provider report "unfilled" to check the house fallback inside the frame.
VITE_WEB_AD_MOCK_RESULT=

# --- Native apps (install promotion) ---
# Build-time only (must redeploy/rebuild after changing). Leave empty to show
# "Coming soon" and link buttons to https://<VITE_BASE_DOMAIN>.
VITE_ANDROID_APP_URL=
VITE_IOS_APP_URL=https://apps.apple.com/pt/app/s%C3%A3o-miguel-bus/id6777066837
# Numeric iOS app id for the native Smart App Banner.
VITE_IOS_APP_ID=6777066837
